    </dict>

    <!--
        Mon-Fri at 06:00, 08:30, 09:00, 09:30, 10:00, 11:00, 12:00.
        launchd's Weekday is a single integer per dict (Mon=1..Fri=5),
        so each time is fanned out across the five weekdays.
    -->
